:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

============================================================
4. CURRENT AI API ROUTE
============================================================
import { NextResponse } from 'next/server';
import { connectionTestAgent } from '@/mastra/agents/connection-test-agent';


const MAX_PROMPT_LENGTH = 10_000;

interface TestRequest {
  prompt?: unknown;
}

export async function POST(request: Request) {
  let body: TestRequest;

  try {
    body = (await request.json()) as TestRequest;
  } catch {
    return NextResponse.json(
      { error: 'Request body must be valid JSON.' },
      { status: 400 },
    );
  }

  if (
    typeof body !== 'object' ||
    body === null ||
    typeof body.prompt !== 'string'
  ) {
    return NextResponse.json(
      { error: 'The "prompt" field must be a string.' },
      { status: 400 },
    );
  }

  const prompt = body.prompt.trim();

  if (!prompt) {
    return NextResponse.json(
      { error: 'The "prompt" field must not be empty.' },
      { status: 400 },
    );
  }

  if (prompt.length > MAX_PROMPT_LENGTH) {
    return NextResponse.json(
      {
        error: `The prompt must not exceed ${MAX_PROMPT_LENGTH} characters.`,
      },
      { status: 413 },
    );
  }

  try {
    const result = await connectionTestAgent.generate(prompt);

    return NextResponse.json({
      result: result.text,
    });
  } catch {
    // Avoid exposing provider errors, credentials, or internal stack traces.
    return NextResponse.json(
      { error: 'AI request failed. Check the server logs for details.' },
      { status: 502 },
    );
  }
}

============================================================
5. CURRENT AUTH CONFIGURATION
============================================================
import NextAuth from "next-auth";
import Keycloak from "next-auth/providers/keycloak";

export const { handlers, auth, signIn, signOut } = NextAuth({
  trustHost: true,

  providers: [
    Keycloak({
      clientId: process.env.AUTH_KEYCLOAK_ID!,
      clientSecret: process.env.AUTH_KEYCLOAK_SECRET!,
      issuer: process.env.AUTH_KEYCLOAK_ISSUER!,
    }),
  ],

  session: {
    strategy: "jwt",
  },

  callbacks: {
    async jwt({ token, profile }) {
      if (profile) {
        const keycloakProfile = profile as {
          realm_access?: {
            roles?: string[];
          };
        };

        token.roles = keycloakProfile.realm_access?.roles ?? [];
      }

      return token;
    },

    async session({ session, token }) {
      if (session.user) {
        session.user.roles = token.roles ?? [];
      }

      return session;
    },
  },
});
import "next-auth";
import "next-auth/jwt";

declare module "next-auth" {
  interface Session {
    user: {
      roles: string[];
    } & NonNullable<DefaultSession["user"]>;
  }
}

declare module "next-auth/jwt" {
  interface JWT {
    roles?: string[];
  }
}

