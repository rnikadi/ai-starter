# Archestra OpenAI-compatible LLM proxy
# Keep the virtual key private; never expose it to browser code.
ARCHESTRA_BASE_URL=http://localhost:9000/v1/openrouter
ARCHESTRA_VIRTUAL_KEY=replace-with-your-archestra-virtual-key
ARCHESTRA_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ARCHESTRA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# NextAuth / Auth.js configuration
AUTH_SECRET=replace-with-generated-32-char-secret
AUTH_URL=http://localhost:3001
AUTH_KEYCLOAK_ID=ai-starter-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/ai-starter
AUTH_KEYCLOAK_SECRET=ai-starter-kit-local-client-secret
# Optional internal Keycloak URL for Docker / containerized server-to-server fetches
AUTH_KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/ai-starter

# Keycloak public hostname (set to your public domain in production)
KC_HOSTNAME=http://localhost:8080

# Backend API server configuration
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Optional public API URL for OpenAPI spec and documentation
BACKEND_PUBLIC_URL=http://localhost:4000

# PostgreSQL Application Database (with pgvector)
DATABASE_URL=postgresql://aistarter:aistarter_local_secret@localhost:5432/aistarter_db
TEST_DATABASE_URL=postgresql://aistarter:aistarter_local_secret@localhost:5432/aistarter_test_db

# Structured Logging Configuration (debug, info, warn, error; pretty or json)
LOG_LEVEL=info
LOG_FORMAT=pretty
