# Archestra's OpenAI-compatible LLM proxy.
# Keep the virtual key private; never expose it to browser code.
ARCHESTRA_BASE_URL=http://localhost:9000/v1
ARCHESTRA_VIRTUAL_KEY=replace-with-your-archestra-virtual-key
ARCHESTRA_MODEL=replace-with-your-archestra-model-id

# NextAuth / Auth.js configuration
AUTH_SECRET=replace-with-generated-32-char-secret
AUTH_URL=http://localhost:3001
AUTH_KEYCLOAK_ID=ai-starter-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/ai-starter
AUTH_KEYCLOAK_SECRET=ai-starter-kit-local-client-secret

# Backend API server configuration
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000

# Optional: Offline Mock AI Mode (set to true to test without Archestra/OpenRouter)
MOCK_AI=false

# Optional: Structured Logging Configuration (debug, info, warn, error; pretty or json)
LOG_LEVEL=info
LOG_FORMAT=pretty

