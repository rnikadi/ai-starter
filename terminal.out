===== 4. USER BOOTSTRAP SCRIPT =====
#!/usr/bin/env bash
set -euo pipefail

KEYCLOAK_URL="${KEYCLOAK_URL:-http://localhost:8080}"

# Load the same administrator credentials used to initialize Keycloak.
# Keep .env.keycloak private; never print its contents.
if [[ -f ".env.keycloak" ]]; then
  set -a
  # shellcheck disable=SC1091
  source ".env.keycloak"
  set +a
fi

ADMIN_USER="${KC_BOOTSTRAP_ADMIN_USERNAME:-admin}"
ADMIN_PASSWORD="${KC_BOOTSTRAP_ADMIN_PASSWORD:-admin}"

DEVELOPER_USER="starter-developer"
DEVELOPER_PASSWORD="StarterDev123!"
VIEWER_USER="starter-viewer"
VIEWER_PASSWORD="StarterView123!"

KCADM="/opt/keycloak/bin/kcadm.sh"

echo "Waiting for Keycloak..."
for attempt in $(seq 1 60); do
  if curl -fsS \
    "${KEYCLOAK_URL}/realms/ai-starter/.well-known/openid-configuration" \
    >/dev/null; then
    break
  fi

  if [ "$attempt" -eq 60 ]; then
    echo "ERROR: Keycloak did not become ready." >&2
    exit 1
  fi

  sleep 2
done

docker exec keycloak "$KCADM" config credentials \
  --server http://localhost:8080 \
  --realm master \
  --user "$ADMIN_USER" \
  --password "$ADMIN_PASSWORD"

ensure_user() {
  local username="$1"
  local password="$2"
  local role="$3"

  if ! docker exec keycloak "$KCADM" get users \
    -r ai-starter -q "username=${username}" 2>/dev/null |
    grep -q '"username"'; then
    docker exec keycloak "$KCADM" create users \
      -r ai-starter \
      -s "username=${username}" \
      -s enabled=true
  fi

  docker exec keycloak "$KCADM" set-password \
    -r ai-starter \
    --username "$username" \
    --new-password "$password"

  docker exec keycloak "$KCADM" add-roles \
    -r ai-starter \
    --uusername "$username" \
    --rolename "$role"

  echo "Configured ${username} with role ${role}."
}

ensure_user "$DEVELOPER_USER" "$DEVELOPER_PASSWORD" developer
ensure_user "$VIEWER_USER" "$VIEWER_PASSWORD" viewer

echo
echo "Local Keycloak test users are ready."
echo "Developer username: ${DEVELOPER_USER}"
echo "Developer password: ${DEVELOPER_PASSWORD}"
echo "Viewer username: ${VIEWER_USER}"
echo "Viewer password: ${VIEWER_PASSWORD}"
echo
echo "These credentials are for local development only."

===== 5. AUTHENTICATION ACTIONS =====
"use server";

import { signIn, signOut } from "@/auth";

export async function signInWithKeycloak() {
  await signIn("keycloak", {
    redirectTo: "/",
    prompt: "login",
  });
}

export async function signOutOfApp() {
  await signOut({
    redirectTo: "/api/auth/keycloak-logout",
  });
}

===== 6. AUTH CONFIGURATION =====
import NextAuth from "next-auth";
import Keycloak from "next-auth/providers/keycloak";

interface KeycloakRoleClaims {
  realm_access?: {
    roles?: string[];
  };
}

function extractRoles(value: unknown): string[] {
  if (!value || typeof value !== "object") {
    return [];
  }

  const claims = value as KeycloakRoleClaims;
  const roles = claims.realm_access?.roles;

  return Array.isArray(roles)
    ? roles.filter((role: unknown): role is string => typeof role === "string")
    : [];
}

function extractIdTokenRoles(idToken: string | undefined): string[] {
  if (!idToken) {
    return [];
  }

  try {
    const payload = idToken.split(".")[1];

    if (!payload) {
      return [];
    }

    const claims = JSON.parse(
      Buffer.from(payload, "base64url").toString("utf8"),
    ) as unknown;

    return extractRoles(claims);
  } catch {
    return [];
  }
}

export const { handlers, auth, signIn, signOut } = NextAuth({
  trustHost: true,

  providers: [
    Keycloak({
      clientId: process.env.AUTH_KEYCLOAK_ID!,
      clientSecret: process.env.AUTH_KEYCLOAK_SECRET!,
      issuer: process.env.AUTH_KEYCLOAK_ISSUER!,
    }),
  ],

  session: {
    strategy: "jwt",
  },

  callbacks: {
    async jwt({ token, profile, account }) {
      if (profile) {
        const profileRoles = extractRoles(profile);

        token.roles =
          profileRoles.length > 0
            ? profileRoles
            : extractIdTokenRoles(account?.id_token);
      }

      return token;
    },

    async session({ session, token }) {
      if (session.user) {
        const roles: string[] = Array.isArray(token.roles)
          ? token.roles.filter(
              (role: unknown): role is string => typeof role === "string",
            )
          : [];

        session.user.roles = roles;
      }

      return session;
    },
  },
});

===== 7. EXISTING LOGOUT ENDPOINT =====
import { NextResponse } from "next/server";

export async function GET(request: Request) {
  const issuer = process.env.AUTH_KEYCLOAK_ISSUER;
  const clientId = process.env.AUTH_KEYCLOAK_ID;

  if (!issuer || !clientId) {
    console.error(
      "Keycloak logout configuration is missing.",
    );

    return NextResponse.json(
      { error: "Keycloak logout is not configured." },
      { status: 500 },
    );
  }

  let issuerUrl: URL;

  try {
    issuerUrl = new URL(issuer);
  } catch {
    return NextResponse.json(
      { error: "The Keycloak issuer URL is invalid." },
      { status: 500 },
    );
  }

  if (
    issuerUrl.protocol !== "http:" &&
    issuerUrl.protocol !== "https:"
  ) {
    return NextResponse.json(
      { error: "The Keycloak issuer must use HTTP or HTTPS." },
      { status: 500 },
    );
  }

  const logoutUrl = new URL(
    `${issuerUrl.pathname.replace(/\/+$/, "")}/protocol/openid-connect/logout`,
    issuerUrl.origin,
  );

  const returnUrl = new URL("/", request.url);

  logoutUrl.searchParams.set("client_id", clientId);
  logoutUrl.searchParams.set(
    "post_logout_redirect_uri",
    returnUrl.toString(),
  );

  return NextResponse.redirect(logoutUrl);
}

