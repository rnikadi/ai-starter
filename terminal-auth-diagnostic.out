
=== 1. Current authentication actions ===
"use server";

import { signIn, signOut } from "@/auth";
import { redirect } from "next/navigation";

export async function signInWithKeycloak() {
  await signIn(
    "keycloak",
    {
      redirectTo: "/",
    },
    {
      prompt: "login",
    },
  );
}

export async function signOutOfApp() {
  await signOut({
    redirect: false,
  });

  redirect("/api/auth/keycloak-logout");
}

=== 2. Auth.js route handler ===
import { handlers } from "@/auth";

export const { GET, POST } = handlers;

=== 3. Auth.js provider endpoint ===
{
  "keycloak": {
    "id": "keycloak",
    "type": "oidc",
    "signinUrl": "http://localhost:3001/api/auth/signin/keycloak"
  }
}

