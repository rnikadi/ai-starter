{
  "name": "ai-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "node -e \"const { spawn } = require('child_process'); spawn('pnpm', ['dev:backend'], { stdio: 'inherit', shell: true }); spawn('pnpm', ['dev:frontend'], { stdio: 'inherit', shell: true });\"",
    "dev:frontend": "cd frontend && next dev --port 3001",
    "dev:backend": "cd backend && tsx watch src/index.ts",
    "dev:down": "docker compose down",
    "dev:status": "docker compose ps",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "monitoring:up": "docker compose --profile monitoring up -d",
    "monitoring:down": "docker compose --profile monitoring down",
    "monitoring:status": "docker compose --profile monitoring ps",
    "docker:build": "docker compose --profile full build",
    "docker:demo": "node scripts/docker-demo.mjs",
    "docker:demo:quick": "node scripts/docker-demo.mjs --no-build",
    "docker:up": "docker compose --profile full up -d",
    "docker:down": "docker compose --profile full down",
    "docker:status": "docker compose --profile full ps",
    "docker:demo:app:down": "docker compose stop frontend backend",
    "docker:demo:app:restart": "docker compose restart frontend backend",
    "build": "cd frontend && next build --webpack",
    "lint": "cd frontend && eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "db:migrate:test": "tsx backend/src/db/migrate.ts --test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "security:scan": "node scripts/scan-secrets.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@mastra/core": "^1.75.0",
    "drizzle-orm": "^0.45.4",
    "mastra": "^1.33.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.25.0"
}
