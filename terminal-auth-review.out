
========== 1. Authentication actions ==========
"use server";

import { signIn, signOut } from "@/auth";
import { redirect } from "next/navigation";

export async function signInWithKeycloak() {
  await signIn(
    "keycloak",
    {
      redirectTo: "/",
    },
    {
      prompt: "login",
    },
  );
}

export async function signOutOfApp() {
  await signOut({
    redirect: false,
  });

  redirect("/api/auth/keycloak-logout");
}

========== 2. Auth.js configuration ==========
import NextAuth from "next-auth";
import Keycloak from "next-auth/providers/keycloak";

interface KeycloakRoleClaims {
  realm_access?: {
    roles?: string[];
  };
}

function extractRoles(value: unknown): string[] {
  if (!value || typeof value !== "object") {
    return [];
  }

  const claims = value as KeycloakRoleClaims;
  const roles = claims.realm_access?.roles;

  return Array.isArray(roles)
    ? roles.filter((role: unknown): role is string => typeof role === "string")
    : [];
}

function extractIdTokenRoles(idToken: string | undefined): string[] {
  if (!idToken) {
    return [];
  }

  try {
    const payload = idToken.split(".")[1];

    if (!payload) {
      return [];
    }

    const claims = JSON.parse(
      Buffer.from(payload, "base64url").toString("utf8"),
    ) as unknown;

    return extractRoles(claims);
  } catch {
    return [];
  }
}

export const { handlers, auth, signIn, signOut } = NextAuth({
  trustHost: true,

  providers: [
    Keycloak({
      clientId: process.env.AUTH_KEYCLOAK_ID!,
      clientSecret: process.env.AUTH_KEYCLOAK_SECRET!,
      issuer: process.env.AUTH_KEYCLOAK_ISSUER!,
    }),
  ],

  session: {
    strategy: "jwt",
  },

  callbacks: {
    async jwt({ token, profile, account }) {
      if (profile) {
        const profileRoles = extractRoles(profile);

        token.roles =
          profileRoles.length > 0
            ? profileRoles
            : extractIdTokenRoles(account?.id_token);
      }

      return token;
    },

    async session({ session, token }) {
      if (session.user) {
        const roles: string[] = Array.isArray(token.roles)
          ? token.roles.filter(
              (role: unknown): role is string => typeof role === "string",
            )
          : [];

        session.user.roles = roles;
      }

      return session;
    },
  },
});

========== 3. Keycloak logout route ==========
import { NextResponse } from "next/server";

async function handleKeycloakLogout(request: Request) {
  const issuer = process.env.AUTH_KEYCLOAK_ISSUER;
  const clientId = process.env.AUTH_KEYCLOAK_ID;

  if (!issuer || !clientId) {
    console.error("Keycloak logout configuration is missing.");

    return NextResponse.json(
      { error: "Keycloak logout is not configured." },
      { status: 500 },
    );
  }

  let issuerUrl: URL;

  try {
    issuerUrl = new URL(issuer);
  } catch {
    return NextResponse.json(
      { error: "The Keycloak issuer URL is invalid." },
      { status: 500 },
    );
  }

  if (
    issuerUrl.protocol !== "http:" &&
    issuerUrl.protocol !== "https:"
  ) {
    return NextResponse.json(
      { error: "The Keycloak issuer must use HTTP or HTTPS." },
      { status: 500 },
    );
  }

  const logoutUrl = new URL(
    `${issuerUrl.pathname.replace(/\/+$/, "")}/protocol/openid-connect/logout`,
    issuerUrl.origin,
  );

  const returnUrl = new URL("/", request.url);

  logoutUrl.searchParams.set("client_id", clientId);
  logoutUrl.searchParams.set(
    "post_logout_redirect_uri",
    returnUrl.toString(),
  );

  return NextResponse.redirect(logoutUrl, 303);
}

export async function GET(request: Request) {
  return handleKeycloakLogout(request);
}

export async function POST(request: Request) {
  return handleKeycloakLogout(request);
}

