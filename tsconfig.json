{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "frontend/src/**/*",
    "backend/src/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "frontend/.next", "dist"]
}
