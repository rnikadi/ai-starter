{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 2,
      "title": "Errors & Warnings (Keycloak, Archestra, Backend, Frontend)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{service=~\"$service\"} |~ \"(?i)(error|warn|fail|fatal|exception)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 14 },
      "id": 3,
      "title": "All Live Logs Stream",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["ai-starter", "logs", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": ".*" },
        "name": "service",
        "label": "Service",
        "type": "custom",
        "options": [
          { "selected": true, "text": "All", "value": ".*" },
          { "selected": false, "text": "backend", "value": "backend" },
          { "selected": false, "text": "frontend", "value": "frontend" },
          { "selected": false, "text": "keycloak", "value": "keycloak" },
          { "selected": false, "text": "archestra", "value": "archestra" }
        ],
        "query": ".*,backend,frontend,keycloak,archestra",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Application Logs Overview",
  "uid": "ai-starter-logs",
  "version": 1
}

